#!/bin/bash

image=reg.nemui.org/cclaude/cclaude

agent="${CCLAUDE_AGENT:-claude}"
case "$agent" in
  claude|codex) ;;
  *)
    printf 'unsupported agent: %s\n' "$agent" >&2
    exit 2
    ;;
esac

container_args=("$@")

if [ "$agent" = codex ]; then
  codex_path="$(command -v codex || true)"
  case "$codex_path" in
    "$HOME/.local/bin/"*|"$HOME/lib/node_modules/.bin/"*) ;;
    *)
      printf 'ccodex: codex is not installed in a mounted command path\n' >&2
      exit 127
      ;;
  esac
  container_args=(codex "$@")
fi

volumes=()

# PipeWire holds the host's ALSA devices, so --device /dev/snd can't reach the
# mic. Relay the pipewire-pulse socket instead; the image's /etc/asound.conf
# points ALSA's default device at it.
pulse_socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pulse/native"
[ -S "$pulse_socket" ] || pulse_socket=""

# Rootless Podman's image store has to outlive --rm, and its overlay upperdir
# cannot sit on the container's own overlay, so keep it on the host. It stays
# out of ~/.local/share/containers: the host's own Podman keeps its store there
# under a different id mapping, and the two would copy layers past each other.
podman_store="$HOME/.local/share/cclaude/containers"
mkdir -p "$podman_store"

for t in /etc/passwd:ro /etc/group:ro \
	~/.claude.json ~/.claude ~/.local/share/claude ~/.local/bin:ro ~/.agents \
	~/.gitconfig:ro ~/.config/ccstatusline:ro ~/.config/gh:ro ~/.cache/ms-playwright \
	~/.nodenv ~/.rustup ~/.rbenv ~/.bun ~/.cargo ~/.npm ~/.inputrc:ro ~/lib/node_modules \
	~/.local/share/pnpm \
	/run/user/$(id -u)/bus:ro ${SSH_AUTH_SOCK} ~/.ssh/known_hosts:ro ${TMUX} \
	~/.codex ${pulse_socket} ${CCLAUDE_VOLUMES} \
	; do
  path="${t%%:*}"
  if [ -z "$path" ]; then
    continue;
  elif [ -L "$path" ]; then
    volumes+=(-v "$(readlink -n "$path"):$t")
  elif [ -e "$path" ]; then
    volumes+=(-v "$path:$t")
  fi
done

# Resolve this pane's KWin window on the host (the container can't reach KWin)
# and inject it so win-record.sh stores it without re-resolving inside the container.
winenv=()
winid="$("$HOME/.claude/hooks/kwin.sh" resolve 2>/dev/null)"
if [ -n "$winid" ]; then
  winenv=(-e CLAUDE_WIN_ID="$winid")
fi

pulseenv=()
if [ -n "$pulse_socket" ]; then
  pulseenv=(-e "PULSE_SERVER=unix:$pulse_socket")
fi

# pasta wires up the network for the containers Podman starts, and opens the
# tun device to do it.
tundev=()
[ -c /dev/net/tun ] && tundev=(--device /dev/net/tun)

export HERDR_AGENT="$agent"

# Claude Code's sandbox runs bubblewrap, which needs unprivileged user
# namespaces plus mount/pivot_root. Docker's default seccomp profile and
# AppArmor profile both block those, so relax them. Rather than
# seccomp=unconfined, deny the syscalls that have no use here: the list below
# is Docker's own default denials minus the namespace and mount group.
# (Codex sandboxes with Landlock instead and needs none of this.)
#
# Rootless Podman needs three relaxations on top: CAP_SYS_ADMIN, without which
# newuidmap cannot write a uid_map for a namespace it does not own; unconfined
# system paths, because a masked /proc blocks the nested procfs mount and a
# read-only /proc/sys blocks crun's sysctls; and sethostname/setdomainname,
# which the list below therefore leaves alone. The capability lands in the
# bounding set only: the entrypoint drops to the user, which clears the
# effective and permitted sets.
seccomp_profile=$(cat <<'JSON'
{
  "defaultAction": "SCMP_ACT_ALLOW",
  "architectures": ["SCMP_ARCH_X86_64", "SCMP_ARCH_X86", "SCMP_ARCH_X32", "SCMP_ARCH_AARCH64", "SCMP_ARCH_ARM"],
  "syscalls": [
    { "action": "SCMP_ACT_ERRNO", "errnoRet": 1, "names": [
      "init_module",
      "finit_module",
      "delete_module",
      "create_module",
      "query_module",
      "get_kernel_syms",
      "kexec_load",
      "kexec_file_load",
      "reboot",
      "iopl",
      "ioperm",
      "swapon",
      "swapoff",
      "acct",
      "uselib",
      "nfsservctl",
      "_sysctl",
      "sysfs",
      "ustat",
      "vhangup",
      "afs_syscall",
      "tuxcall",
      "vserver",
      "security",
      "getpmsg",
      "putpmsg"
    ] },
    { "action": "SCMP_ACT_ERRNO", "errnoRet": 1, "names": [
      "bpf",
      "perf_event_open",
      "uprobe",
      "lookup_dcookie",
      "kcmp",
      "pidfd_getfd",
      "process_madvise",
      "open_by_handle_at",
      "open_tree_attr",
      "listns",
      "lsm_get_self_attr",
      "lsm_set_self_attr",
      "lsm_list_modules",
      "file_getattr",
      "file_setattr"
    ] },
    { "action": "SCMP_ACT_ERRNO", "errnoRet": 1, "names": [
      "keyctl",
      "add_key",
      "request_key"
    ] },
    { "action": "SCMP_ACT_ERRNO", "errnoRet": 1, "names": [
      "userfaultfd",
      "io_uring_setup",
      "io_uring_enter",
      "io_uring_register"
    ] },
    { "action": "SCMP_ACT_ERRNO", "errnoRet": 1, "names": [
      "settimeofday",
      "clock_settime",
      "syslog",
      "quotactl",
      "quotactl_fd",
      "fanotify_init"
    ] },
    { "action": "SCMP_ACT_ERRNO", "errnoRet": 1, "names": [
      "mbind",
      "migrate_pages",
      "move_pages",
      "get_mempolicy",
      "set_mempolicy",
      "set_mempolicy_home_node"
    ] },
    { "action": "SCMP_ACT_ERRNO", "errnoRet": 1, "names": [
      "rseq_slice_yield"
    ] }
  ]
}
JSON
)

exec docker run -w "$PWD" -v "$PWD:$PWD" \
  --device /dev/kvm --device /dev/snd "${tundev[@]}" \
  -e LANG -e LANGUAGE -e LC_CTYPE -e LC_NUMERIC -e LC_TIME -e LC_COLLATE -e LC_MONETARY -e LC_MESSAGES \
  -e LC_PAPER -e LC_NAME -e LC_ADDRESS -e LC_TELEPHONE -e LC_MEASUREMENT -e LC_IDENTIFICATION -e LC_ALL \
  -e PATH -e COLORTERM -e TERM -e DBUS_SESSION_BUS_ADDRESS -e USER -e HOME -e SSH_AUTH_SOCK \
  -e TERM_PROGRAM -e WEZTERM_PANE -e WEZTERM_UNIX_SOCKET -e TMUX -e TMUX_PANE \
  -e KONSOLE_DBUS_ACTIVATION_COOKIE -e KONSOLE_DBUS_SESSION -e KONSOLE_DBUS_WINDOW \
  -e OPENROUTER_API_KEY -e ANTHROPIC_BASE_URL -e ANTHROPIC_AUTH_TOKEN -e ANTHROPIC_API_KEY \
  -e ANTHROPIC_DEFAULT_OPUS_MODEL -e ANTHROPIC_DEFAULT_SONNET_MODEL \
  -e ANTHROPIC_DEFAULT_HAIKU_MODEL -e ANTHROPIC_DEFAULT_FABLE_MODEL \
  -e TZ="$(timedatectl show --property=Timezone --value)" \
  "${winenv[@]}" "${pulseenv[@]}" \
  --security-opt seccomp=<(printf '%s' "$seccomp_profile") --security-opt apparmor=unconfined \
  --security-opt systempaths=unconfined --cap-add SYS_ADMIN \
  --rm -it "${volumes[@]}" -v "$podman_store:$HOME/.local/share/containers" \
  "$image" "${container_args[@]}"

