#!/bin/bash

image=reg.nemui.org/cclaude/cclaude

volumes=()

# PipeWire holds the host's ALSA devices, so --device /dev/snd can't reach the
# mic. Relay the pipewire-pulse socket instead; the image's /etc/asound.conf
# points ALSA's default device at it.
pulse_socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pulse/native"
[ -S "$pulse_socket" ] || pulse_socket=""

for t in /etc/passwd:ro /etc/group:ro \
	~/.claude.json ~/.claude ~/.local/share/claude ~/.local/bin:ro ~/.agents \
	~/.gitconfig:ro ~/.config/ccstatusline:ro ~/.config/gh:ro ~/.cache/ms-playwright \
	~/.nodenv ~/.rustup ~/.rbenv ~/.bun ~/.cargo ~/.npm ~/.inputrc:ro ~/lib/node_modules \
	/run/user/$(id -u)/bus:ro ${SSH_AUTH_SOCK} ~/.ssh/known_hosts:ro ${TMUX} \
	~/.codex ${pulse_socket} ${CCLAUDE_VOLUMES} \
	; do
  path="${t%%:*}"
  if [ -z "$path" ]; then
    continue;
  elif [ -L "$path" ]; then
    volumes+=(-v "$(readlink -n "$path"):$t")
  elif [ -e "$path" ]; then
    volumes+=(-v "$path:$t")
  fi
done

# Resolve this pane's KWin window on the host (the container can't reach KWin)
# and inject it so win-record.sh stores it without re-resolving inside the container.
winenv=()
winid="$("$HOME/.claude/hooks/kwin.sh" resolve 2>/dev/null)"
if [ -n "$winid" ]; then
  winenv=(-e CLAUDE_WIN_ID="$winid")
fi

pulseenv=()
if [ -n "$pulse_socket" ]; then
  pulseenv=(-e "PULSE_SERVER=unix:$pulse_socket")
fi

export HERDR_AGENT=claude
exec docker run -w "$PWD" -v "$PWD:$PWD" \
  --device /dev/kvm --device /dev/snd \
  -e LANG -e LANGUAGE -e LC_CTYPE -e LC_NUMERIC -e LC_TIME -e LC_COLLATE -e LC_MONETARY -e LC_MESSAGES \
  -e LC_PAPER -e LC_NAME -e LC_ADDRESS -e LC_TELEPHONE -e LC_MEASUREMENT -e LC_IDENTIFICATION -e LC_ALL \
  -e PATH -e COLORTERM -e TERM -e DBUS_SESSION_BUS_ADDRESS -e USER -e HOME -e SSH_AUTH_SOCK \
  -e TERM_PROGRAM -e WEZTERM_PANE -e WEZTERM_UNIX_SOCKET -e TMUX -e TMUX_PANE \
  -e KONSOLE_DBUS_ACTIVATION_COOKIE -e KONSOLE_DBUS_SESSION -e KONSOLE_DBUS_WINDOW \
  -e OPENROUTER_API_KEY -e ANTHROPIC_BASE_URL -e ANTHROPIC_AUTH_TOKEN -e ANTHROPIC_API_KEY \
  -e ANTHROPIC_DEFAULT_OPUS_MODEL -e ANTHROPIC_DEFAULT_SONNET_MODEL \
  -e ANTHROPIC_DEFAULT_HAIKU_MODEL -e ANTHROPIC_DEFAULT_FABLE_MODEL \
  -e TZ="$(timedatectl show --property=Timezone --value)" \
  "${winenv[@]}" "${pulseenv[@]}" \
  --rm -it "${volumes[@]}" \
  "$image" "${@}"

